# Local development (compose.dev.yaml). In Easypanel, set DATABASE_URL in the
# app's Environment tab to the Postgres service's internal connection URL.
DATABASE_URL=postgres://erp:erp@localhost:5432/erp
TEST_DATABASE_URL=postgres://erp:erp@localhost:5432/erp_test

# Better Auth. In Easypanel: a long random secret (`openssl rand -base64 32`) and
# the public URL, e.g. https://erp.example.com
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# The only email allowed to create the first Owner at /setup (first run only).
BOOTSTRAP_OWNER_EMAIL=

# Accurate Online (Legacy System), read-only, for `npm run accurate:export-coa`.
# Local only, never on the VPS. In Accurate: Pengaturan > API Token. One token per
# Accurate database, named by our Company code: ACCURATE_API_TOKEN_<CODE>.
ACCURATE_SIGNATURE_SECRET=
ACCURATE_API_TOKEN_CVA=
# ACCURATE_API_TOKEN_CVB=
# ACCURATE_API_TOKEN_CVC=
# If a token has its own signature secret: ACCURATE_SIGNATURE_SECRET_<CODE>=
